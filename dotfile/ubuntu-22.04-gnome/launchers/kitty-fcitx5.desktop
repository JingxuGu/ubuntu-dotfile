[Desktop Entry]
Version=1.0
Type=Application
Name=kitty
GenericName=Terminal emulator
Comment=Kitty terminal with Fcitx5 input enabled
TryExec=/usr/bin/kitty
Exec=/usr/bin/env GLFW_IM_MODULE=ibus GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx /usr/bin/kitty
Icon=kitty
Categories=System;TerminalEmulator;
